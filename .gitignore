logs/
tmp/
scratch/

# Editor and OS
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# The Tauri shell's build output
shell/target/
shell/gen/

# build output of the C decomposer (built by tools/build_app.py)
*.pdb
*.lib
*.o
.zig-cache*/

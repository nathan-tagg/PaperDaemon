{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PaperDaemon",
  "mainBinaryName": "PaperDaemon",
  "version": "0.1.83",
  "identifier": "org.paperdaemon.desktop",
  "build": {
    "frontendDist": "dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "publisher": "The PaperDaemon Authors",
    "copyright": "Copyright 2026 The PaperDaemon Authors",
    "license": "Apache-2.0",
    "shortDescription": "Answers tagged reMarkable pages with the models you choose",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "template": "installer/installer.nsi",
        "installerIcon": "icons/icon.ico",
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "NOT SET: tools/build_app.py writes the release's public update key here (--update-key). Make the key pair once with `npx tauri signer generate`, keep the private key off the repository, and pass both to the build; see CONTRIBUTING.md, Releasing.",
      "endpoints": [
        "https://github.com/OWNER/paperdaemon/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
